# Copy to .env to override. With Docker Compose these are set for you.

# Base URL of the API. The mock server (frontendchallengeserver) listens on 3000.
VITE_API_BASE_URL=http://localhost:3000

# Path parameters of action-blueprint-graph-get. The mock ignores them and
# always returns graph.json; the real API needs all three.
VITE_TENANT_ID=1
VITE_BLUEPRINT_ID=bp_01jk766tckfwx84xjcxazggzyc
# VITE_BLUEPRINT_VERSION_ID=bpv_123

# Prefill data sources to offer, comma-separated ids in display order.
# Unset or empty = every registered source.
# VITE_PREFILL_SOURCES=direct_dependencies,global_data
